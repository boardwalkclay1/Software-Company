/* ================================
   GO TIME SOFTWARE — COBALT THEME
   ================================ */

body.theme-cobalt {
  background: radial-gradient(circle at top, #020617, #000);
  color: #7aa2ff;
}

/* Headers */
h1, h2, h3 {
  color: #7aa2ff;
}

/* Buttons */
.btn-primary {
  background: #4f7cff;
  color: #fff;
  border: 1px solid #4f7cff;
}

.btn-secondary {
  background: #1e293b;
  color: #7aa2ff;
  border: 1px solid #4f7cff55;
}

.btn-ghost {
  background: transparent;
  color: #7aa2ff;
  border: 1px solid #4f7cff55;
}

/* Cards */
.feature-card,
.price-card,
.testimonial,
.product-card,
.game-card {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid #4f7cff33;
}

/* Inputs */
input, textarea {
  background: #0f172a;
  color: #7aa2ff;
  border: 1px solid #4f7cff55;
}

/* Navigation */
.nav a {
  color: #7aa2ff;
}

.nav-cta {
  background: #4f7cff;
  color: #fff;
  padding: 0.5rem 1rem;
  border-radius: 6px;
}
